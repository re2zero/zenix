# Maintainer: re2zero <yangwu@uniontech.com>
# Contributor: zenix contributors
#
# Build instructions for Arch Linux / Manjaro / EndeavourOS.
#
# Quick build from within the cloned repo:
#   cd <repo-root> && makepkg -fp archlinux/PKGBUILD
#
# Or use the AUR / manual download workflow:
#   curl -LO https://github.com/re2zero/zenix/archive/refs/tags/v0.1.0.tar.gz
#   # then adjust pkgver and source below
#
# Required packages (install before building):
#   sudo pacman -S --needed base-devel rust git curl libxcb \
#     libxkbcommon fontconfig freetype2 expat wayland libglvnd
#
# The herdr daemon is a pinned release binary (vendor/herdr-pins.tsv), fetched
# by scripts/fetch-herdr.sh — no Zig toolchain and no submodule.

pkgname=zenix
pkgver=0.1.0
pkgrel=1
pkgdesc="A cross-platform GPUI frontend for herdr terminal workspace manager — extensible with plugins and sub-apps"
arch=('x86_64')
url='https://github.com/re2zero/zenix'
license=('GPL-3.0-or-later')
depends=(
  'libxcb'
  'libxkbcommon'
  'fontconfig'
  'freetype2'
  'wayland'
  'libglvnd'
)
makedepends=(
  'cargo'
  'git'
  # The herdr daemon is a pinned release binary (`vendor/herdr-pins.tsv`,
  # fetched by scripts/fetch-herdr.sh), so no Zig toolchain is needed.
  'curl'
)
install=zenix.install
source=(
  "${pkgname}::git+${url}.git#tag=v${pkgver}"
)
sha256sums=('SKIP')

# The crates.io index is large; allow network access during build.
validpgpkeys=()

# The daemon seed is downloaded, not compiled: build.rs copies res/herdr next to
# the binary and checks it against the pin.
prepare() {
  cd "${srcdir}/${pkgname}"
  HERDR_DOWNLOAD_BASE="${HERDR_DOWNLOAD_BASE:-https://github.com/herdrdev/herdr/releases/download}" \
    ./scripts/fetch-herdr.sh
}

pkgver() {
  cd "${srcdir}/${pkgname}"
  git describe --tags --always 2>/dev/null || echo "${pkgver}"
}

build() {
  cd "${srcdir}/${pkgname}"
  cargo build --release
}

package() {
  cd "${srcdir}/${pkgname}"

  install -Dm755 "target/release/zenix" "${pkgdir}/usr/bin/zenix"

  # herdr companion binary (built by build.rs)
  if [ -f "target/release/herdr" ]; then
    install -Dm755 "target/release/herdr" "${pkgdir}/usr/share/zenix/herdr"
  fi

  # Desktop entry
  install -Dm644 "res/zenix.desktop" "${pkgdir}/usr/share/applications/zenix.desktop"

  # Icon
  install -Dm644 "res/zenix.png" \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/zenix.png"

  # Documentation
  install -Dm644 "README.md" "${pkgdir}/usr/share/doc/zenix/README.md"
  install -Dm644 "LICENSE"  "${pkgdir}/usr/share/doc/zenix/LICENSE"

  # License texts — same inventory as [package.metadata.deb] in Cargo.toml.
  # The Lilex faces are compiled into the binary, so no font files ship, but
  # OFL-1.1 still requires the license text to travel with the font.
  install -Dm644 "THIRD-PARTY.md" "${pkgdir}/usr/share/doc/zenix/THIRD-PARTY.md"
  install -Dm644 "assets/fonts/OFL.txt" "${pkgdir}/usr/share/doc/zenix/Lilex-OFL.txt"
  install -Dm644 "licenses/herdr/LICENSE" "${pkgdir}/usr/share/doc/zenix/herdr/LICENSE"
  for crate in herdr-client herdr-protocol; do
    install -Dm644 "vendor/${crate}/LICENSE-APACHE" \
      "${pkgdir}/usr/share/doc/zenix/${crate}/LICENSE-APACHE"
    install -Dm644 "vendor/${crate}/NOTICE.md" \
      "${pkgdir}/usr/share/doc/zenix/${crate}/NOTICE.md"
  done
}
